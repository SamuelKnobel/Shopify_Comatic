SHOPIFY_STORE=your-store.myshopify.com
SHOPIFY_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

COMATIC_BASE_URL=https://your-comatic-instance.example.com
COMATIC_API_VERSION=v3
COMATIC_USERNAME=your_comatic_user
COMATIC_PASSWORD=your_comatic_password
COMATIC_DEFAULT_VAT_CODE=NN
COMATIC_DEFAULT_SALES_CONDITION=30
COMATIC_DEFAULT_PURCHASE_CONDITION=30
COMATIC_DEFAULT_STOCK_LOCATION=1
COMATIC_DEFAULT_VAT_TYPE=1
COMATIC_DEFAULT_CHARGE_FACTOR=1
COMATIC_DEFAULT_ACCOUNTING_RATE=1

SQLITE_DB_PATH=sync.db
LOG_FILE=shopify_comatic.log
SYNC_LOOKBACK_HOURS=24
